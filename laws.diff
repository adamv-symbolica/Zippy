+    val selectors = Vector.tabulate(4)(i => SpaceMention(s"selector$i"))
+    val probe = SpaceMention("probe")
+    val factors = Vector("x", "y", "z").map(SpaceMention.apply)
+    val product = factors.map(Space.Mention.apply).reduce(Space.Composition.apply)
+    val body = selectors.map { selector =>
+      Space.Composition(
+        Space.Intersection(Space.Mention(selector), Space.Mention(probe)),
+        product,
+      )
+    }.reduce(Space.Union.apply)
+    val mentions = probe +: (selectors ++ factors)
+    val routine = Routine(RoutinePtr("guarded_union"), Vector.empty, mentions, body)
+    val graph = optimize(transpile(routine))
+
+    assertGraphWellScoped(graph, "guarded union")
+    assertEquals(graphOps(graph).count(_ == "GuardedUnion"), 1)
+
+    val rng = Random(2917441L)
+    for sample <- 0 until 100 do
+      val selectorValues = selectors.map { selector =>
+        val paths = (0 until 4).filter(_ => rng.nextBoolean()).map(i => Syntax.parse(s"k$i"))
+        selector -> SpaceValue(paths.toSet)
+      }
+      val probeValue = SpaceValue((0 until 4).filter(_ => rng.nextBoolean()).map(i => Syntax.parse(s"k$i")).toSet)
+      val factorValues = factors.map { factor =>
+        factor -> SpaceValue(PathValue(PathItem(s"${factor.s}_$sample") :: Nil))
+      }
+      val values = (selectorValues ++ factorValues :+ (probe -> probeValue)).toMap
+      val ctx = SpaceContextMap(values)
+      val tctx = TrieSpaceContext.fromReference(ctx)
+      val expected = eval(body)(using sc = ctx)
+      assertEquals(execValue(graph, mentions, ctx), expected, s"sample $sample exec")
+      assertEquals(execTValue(graph, mentions, tctx), expected, s"sample $sample execT")
+
+    val oneActiveValues = selectors.zipWithIndex.map { (selector, i) =>
+      selector -> SpaceValue(s"k$i")
+    }.toMap ++ factors.map(factor => factor -> SpaceValue(factor.s)).toMap +
+      (probe -> SpaceValue("k2"))
+    val oneActive = SpaceContextMap(oneActiveValues)
+    val stack = collection.mutable.Stack(new Array[List[Int] | TrieSpace | Null](graph.nodes.length))
+    val trieContext = TrieSpaceContext.fromReference(oneActive)
+    mentions.zipWithIndex.foreach((mention, index) => stack.top(index) = trieContext.resolve(mention))
+    val profile = new ExecTProfile
+    execT(graph, stack, profile = profile)
+    assertEquals(profile.outcomeCounts.getOrElse("GuardedUnion" -> "active", 0L), 1L)
+    assertEquals(profile.outcomeCounts.getOrElse("GuardedUnion" -> "root-pruned", 0L), 3L)
+    assertEquals(profile.operationCount("Intersection"), 1L)
+    assertEquals(profile.operationCount("GuardedUnion"), 1L)
+  }
