+/**
+ * Split a segmented quotient only where another path segment raises the
+ * binder level needed to evaluate the prefix. The resulting outer quotient
+ * is loop invariant and can be moved by the ordinary graph passes.
+ *
+ * For example, at levels 0 < i < j:
+ *
+ *   unwrap(S@0, a@0, x@i, b@0, y@j)
+ *
+ * becomes:
+ *
+ *   unwrap(unwrap(unwrap(S@0, a@0), x@i, b@0), y@j)
+ *
+ * Constants following a varying segment remain in that segment's stage;
+ * moving them before the varying segment would change path order.
+ */
+def factor_loop_invariant_unwrap_prefixes(g: RecursiveOpGraph): RecursiveOpGraph =
+  val remaps = ArrayBuffer.empty[collection.mutable.Map[Int, (Int, Int)]]
+
+  def remap(pos: (Int, Int)): (Int, Int) =
+    val (level, index) = pos
+    if level >= 0 && level < remaps.length then remaps(level).getOrElse(index, pos)
+    else pos
+
+  def rebuild(src: RecursiveOpGraph, parent: Option[RecursiveOpGraph]): RecursiveOpGraph =
+    require(src.level == remaps.length,
+      s"cannot factor graph at level ${src.level} with ${remaps.length} active remap frames")
+    val out = RecursiveOpGraph(
+      src.root,
+      parent,
+      ArrayBuffer.empty,
+      parent.map(_.literalPool).getOrElse(src.literalPool),
+    )
+    val frame = collection.mutable.Map.empty[Int, (Int, Int)]
+    remaps += frame
+
+    def storeNode(node: Node[(Int, Int)]): (Int, Int) =
+      val mapped = node.map(remap)
+      if mapped.operation != "Unwrap" || mapped.inputs.length < 3 then out.store(mapped)
+      else
+        val source = mapped.inputs.head
+        val pathInputs = mapped.inputs.tail
+        val groups = Vector.newBuilder[Vector[(Int, Int)]]
+        var current = Vector(pathInputs.head)
+        var availability = source._1.max(pathInputs.head._1)
+        var i = 1
+        while i < pathInputs.length do
+          val input = pathInputs(i)
+          val nextAvailability = availability.max(input._1)
+          if nextAvailability > availability then
+            groups += current
+            current = Vector(input)
+          else current :+= input
+          availability = nextAvailability
+          i += 1
+        groups += current
+        val stages = groups.result()
+        if stages.length == 1 then out.store(mapped)
+        else
+          var stagedSource = source
+          stages.foreach { stage =>
+            stagedSource = out.store(Node("Unwrap", mapped.constant, mapped.kind, stagedSource +: stage))
+          }
+          stagedSource
+
+    src.nodes.zipWithIndex.foreach {
+      case (Left(node), index) =>
+        frame(index) = storeNode(node)
+      case (Right(subgraph), index) =>
+        frame(index) = out.store(rebuild(subgraph, Some(out)))
+    }
+    out.root = src.root.map(remap)
+    remaps.remove(remaps.length - 1)
+    out
+
+  rebuild(g, g.parent)
+
+/**
+ * Semijoin an iteration source with the root keys of an invariant lookup.
+ * The original lookup remains in the body, preserving all payload tails.
+ * Rewriting is allowed only when the result is proven empty whenever that
+ * lookup result is empty.
+ */
+def restrict_iteration_sources_by_strict_unwrap(g: RecursiveOpGraph): RecursiveOpGraph =
+  val remaps = ArrayBuffer.empty[collection.mutable.Map[Int, (Int, Int)]]
+
+  def remap(pos: (Int, Int)): (Int, Int) =
+    val (level, index) = pos
+    if level >= 0 && level < remaps.length then remaps(level).getOrElse(index, pos)
+    else pos
+
+  def strictIn(owner: RecursiveOpGraph,
+               output: (Int, Int),
+               target: (Int, Int),
+               memo: collection.mutable.Map[(RecursiveOpGraph, (Int, Int)), Boolean]): Boolean =
+    if output == target then true
+    else if output._1 < target._1 then false
+    else memo.getOrElseUpdate(owner -> output, owner.lookup(output) match
+      case Left(node) =>
+        def input(index: Int): Boolean = strictIn(owner, node.inputs(index), target, memo)
+        node.operation match
+          case "Empty" => true
+          case "Alias" | "Wrap" | "Unwrap" | "TailsUnion" | "TailsIntersection" |
+               "PrefixClosure" | "SuffixClosure" | "TailsClosure" | "Head" | "Range" =>
+            input(0)
+          case "Union" => node.inputs.indices.forall(input)
+          case "Intersection" => node.inputs.indices.exists(input)
+          case "Restriction" | "Composition" => input(0) || input(1)
+          case "Subtraction" | "Raffination" => input(0)
+          case _ => false
+      case Right(subgraph) =>
+        subgraph.root.operation match
+          case "Iteration" | "SemijoinIteration" =>
+            strictIn(owner, subgraph.root.inputs.head, target, memo) ||
+              strictIn(subgraph, subgraph.level -> (subgraph.nodes.length - 1), target, memo)
+          case _ => false
+    )
+
+  def lookupSources(iteration: RecursiveOpGraph): Vector[(Int, Int)] =
+    val result = iteration.level -> (iteration.nodes.length - 1)
+    iteration.nodes.zipWithIndex.collect {
+      case (Left(Node("Unwrap", _, "space", inputs)), index)
+          if inputs.length >= 2 &&
+             inputs.head._1 < iteration.level &&
+             inputs(1) == (iteration.level -> 0) &&
+             strictIn(iteration, result, iteration.level -> index, collection.mutable.HashMap.empty) =>
+        inputs.head
+    }.distinct.toVector
+
+  def rebuild(src: RecursiveOpGraph, parent: Option[RecursiveOpGraph]): RecursiveOpGraph =
+    require(src.level == remaps.length,
+      s"cannot semijoin graph at level ${src.level} with ${remaps.length} active remap frames")
+    val out = RecursiveOpGraph(
+      src.root,
+      parent,
+      ArrayBuffer.empty,
+      parent.map(_.literalPool).getOrElse(src.literalPool),
+    )
+    val frame = collection.mutable.Map.empty[Int, (Int, Int)]
+    remaps += frame
+
+    src.nodes.zipWithIndex.foreach {
+      case (Left(node), index) =>
+        frame(index) = out.store(node.map(remap))
+      case (Right(subgraph), index) =>
+        val child = rebuild(subgraph, Some(out))
+        if child.root.operation == "Iteration" || child.root.operation == "SemijoinIteration" then
+          val existing =
+            if child.root.operation == "SemijoinIteration" then child.root.inputs.tail
+            else Vector.empty
+          val lookups = existing ++ lookupSources(child).filterNot(existing.contains)
+          if lookups.nonEmpty then
+            child.root = child.root.copy(
+              operation = "SemijoinIteration",
+              inputs = child.root.inputs.head +: lookups,
+            )
+        frame(index) = out.store(child)
+    }
+    out.root = src.root.map(remap)
+    remaps.remove(remaps.length - 1)
+    out
+
+  rebuild(g, g.parent)
+
