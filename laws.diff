+    val tail = SpaceMention("tail")
+    val lookupAtHead = Space.Unwrap(Space.Mention(lookup), Path.Deref(head))
+    val emitPayloadAndHead = Space.Composition(lookupAtHead, Space.Singleton(Path.Deref(head)))
+
+    def compile(body: Space, semijoin: Boolean): RecursiveOpGraph =
+      val routine = Routine(
+        RoutinePtr(if semijoin then "strict_semijoin" else "strict_baseline"),
+        Vector.empty,
+        Vector(source, lookup),
+        Space.Iteration(Space.Mention(source), head, tail, body),
+      )
+      optimizeTimed(
+        transpile(routine, flattenPathConcats = true),
+        factorUnwrapPrefixes = true,
+        restrictIterationsByLookup = semijoin,
+      ).graph
+
+    val baseline = compile(emitPayloadAndHead, semijoin = false)
+    val optimized = compile(emitPayloadAndHead, semijoin = true)
+    assertEquals(graphOperationCount(baseline, "SemijoinIteration"), 0)
+    assert(graphOperationCount(optimized, "SemijoinIteration") > 0)
