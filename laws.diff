+      val lookupValue = SpaceValue(Vector.fill(36)(TraUniversalLawBenchmark.randomPath(rng, 1 + rng.nextInt(5))).toSet)
+      val contexts = TrieSpaceContext.fromReference(SpaceContextMap(Map(source -> sourceValue, lookup -> lookupValue)))
+      def run(graph: RecursiveOpGraph): SpaceValue =
+        val stack = collection.mutable.Stack(new Array[List[Int] | TrieSpace | Null](graph.nodes.length))
+        stack.top(0) = contexts.resolve(source)
+        stack.top(1) = contexts.resolve(lookup)
+        execT(graph, stack)
+        stack.top.last.asInstanceOf[TrieSpace].toSpaceValue
+      val expected = run(baseline)
+      assertEquals(run(optimized), expected)
+
+      val setStack = collection.mutable.Stack(new Array[PathValue | SpaceValue | Null](optimized.nodes.length))
+      setStack.top(0) = sourceValue
+      setStack.top(1) = lookupValue
+      exec(optimized, setStack)
+      assertEquals(setStack.top.last.asInstanceOf[SpaceValue], expected)
+
+      val trieStack = collection.mutable.Stack(new Array[PathValue | TrieSpace | Null](optimized.nodes.length))
+      trieStack.top(0) = contexts.resolve(source)
+      trieStack.top(1) = contexts.resolve(lookup)
+      execTrie(optimized, trieStack)
+      assertEquals(trieStack.top.last.asInstanceOf[TrieSpace].toSpaceValue, expected)
+
+    val nonStrictBody = Space.Union(emitPayloadAndHead, Space.Singleton(Path.Deref(head)))
+    val nonStrict = compile(nonStrictBody, semijoin = true)
+    assertEquals(graphOperationCount(nonStrict, "SemijoinIteration"), 0,
+      "a branch that survives an empty lookup must prevent semijoin pruning")
+  }
