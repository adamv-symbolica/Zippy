; Generated by morkl.CornerstoneProofArtifactMain
; Example: scc
; Mutual reachability pairs from a direct transitive-closure SCC program.

(datatype Cert
  (trie_eval String)
  (reference_eval String)
  (source_optimized String)
  (source_original String)
  (zipper_materialized String)
  (space_eval_trie String)
  (graph_execT String)
  (Result String))

(let $trie_eval (trie_eval "scc"))
(let $reference_eval (reference_eval "scc"))
(let $source_optimized (source_optimized "scc"))
(let $source_original (source_original "scc"))
(let $zipper_materialized (zipper_materialized "scc"))
(let $space_eval_trie (space_eval_trie "scc"))
(let $graph_execT (graph_execT "scc"))

; trie_vs_reference: Trie evaluator output equals reference set evaluator output.
(rewrite (trie_eval "scc") (Result "11eedd251a72927bcfe7e106"))
(rewrite (reference_eval "scc") (Result "11eedd251a72927bcfe7e106"))

; space_optimized: Default source optimizer output equals original Space/term output.
(rewrite (source_optimized "scc") (Result "11eedd251a72927bcfe7e106"))
(rewrite (source_original "scc") (Result "11eedd251a72927bcfe7e106"))
; zipper_vs_space: Scala zipper program materialization equals eager Space/Trie evaluation.
(rewrite (zipper_materialized "scc") (Result "11eedd251a72927bcfe7e106"))
(rewrite (space_eval_trie "scc") (Result "11eedd251a72927bcfe7e106"))
; graph_execT_vs_space: Scala operation graph execT output equals eager Space/Trie evaluation.
(rewrite (graph_execT "scc") (Result "11eedd251a72927bcfe7e106"))
(run 10)

(check (= $trie_eval $reference_eval))

(check (= $source_optimized $source_original))

(check (= $zipper_materialized $space_eval_trie))

(check (= $graph_execT $space_eval_trie))

